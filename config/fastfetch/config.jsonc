{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
    "padding": {
      "left": 1
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "38;2;115;208;255",
      "title": "38;2;212;191;255",
      "separator": "38;2;33;37;44",
      "output": "38;2;197;205;217"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": " {user-name}@{host-name}"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;33;37;44"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": " Kernel"
    },
    {
      "type": "uptime",
      "key": " Uptime"
    },
    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "showPeCoreCount": false
    },
    {
      "type": "gpu",
      "key": " GPU",
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "󰍛 RAM"
    },
    {
      "type": "disk",
      "key": " Disco",
      "folders": "/"
    },
    {
      "type": "custom",
      "key": "󰏘 Tema",
      "format": "opulo"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    }
  ]
}